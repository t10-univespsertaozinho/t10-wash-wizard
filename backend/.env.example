# Ambiente de execução (development, production, test)
# Em produção (Render, Railway, etc.) use NODE_ENV=production e defina as
# variáveis abaixo no painel do serviço, não em um arquivo .env commitado.
NODE_ENV=development

# Configuração da porta do servidor Express
# O Render injeta PORT automaticamente; não é preciso definir no painel.
PORT=3001

# Origem liberada no CORS. OBRIGATÓRIA quando NODE_ENV=production.
# No Render, use a URL pública do frontend, sem barra final
# (ex.: https://wash-wizard.onrender.com). Em desenvolvimento, o padrão é
# http://localhost:8080.
FRONTEND_URL=http://localhost:8080

# Segredo usado para assinar e validar os tokens JWT.
# OBRIGATÓRIO em produção, com no mínimo 32 caracteres e diferente do valor de
# exemplo. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque_por_um_segredo_aleatorio_longo

# Senhas usadas APENAS por `npm run seed` (povoamento do banco). Não são
# necessárias para o boot da API: um serviço web em produção sobe normalmente
# sem elas. Em produção, o seed recusa as senhas padrão e aborta antes de
# apagar qualquer dado.
SEED_ADMIN_PASSWORD=admin123
SEED_OPERADOR_PASSWORD=operador123

# PostgreSQL (Supabase em produção/deploy). String de conexão completa.
# OBRIGATÓRIA: o servidor não inicia sem ela.
#   postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
# No Supabase use a connection string do "Connection Pooler" (porta 6543) em
# ambientes serverless, ou a direta (porta 5432) em servidor dedicado.
# A senha precisa estar codificada como URL (ex.: @ → %40).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/wash_wizard

# SSL do PostgreSQL. Vazio (padrão): TLS habilitado para hosts remotos
# (Supabase/Render) e desligado para localhost/127.0.0.1. Use `disable` para
# forçar sem TLS ou `require` para forçar TLS.
# Também é respeitado o `?sslmode=` presente na própria DATABASE_URL.
PGSSLMODE=

# Tamanho do pool de conexões do `pg` (opcional, padrão 5).
PG_POOL_MAX=5

# Banco descartável usado exclusivamente por `npm test`. NUNCA aponte para o
# Supabase nem para o mesmo banco de DATABASE_URL: a suíte apaga os dados.
# No Render, o `npm test` não roda no boot; esta variável só é necessária no CI.
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/wash_wizard_test
