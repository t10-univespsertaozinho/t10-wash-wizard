# Ambiente de execução (development, production, test)
NODE_ENV=development

# Configuração da porta do servidor Express
PORT=3001

# Origem liberada no CORS (obrigatória em produção)
FRONTEND_URL=http://localhost:8080

# Segredo usado para assinar e validar os tokens JWT
JWT_SECRET=troque_por_um_segredo_aleatorio_longo

# Usados apenas por backend/seed.js para gerar as senhas iniciais
SEED_ADMIN_PASSWORD=admin123
SEED_OPERADOR_PASSWORD=operador123

# Configurações do Supabase / PostgreSQL (para migração futura e deploy)
# SUPABASE_URL=https://sua-instancia.supabase.co
# SUPABASE_ANON_KEY=sua-anon-key
# DATABASE_URL=postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJETO].supabase.co:5432/postgres
