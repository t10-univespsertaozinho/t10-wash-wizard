rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função para verificar se o usuário é admin
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Função para verificar propriedade do documento
    function isOwner(field) {
      return request.auth.uid == resource.data[field];
    }
    
    function isOwnerOrAdmin(field) {
      return request.auth.uid == resource.data[field] || isAdmin();
    }
    
    function isOwnWrite(field) {
      return request.auth.uid == request.resource.data[field];
    }

    // ==================== COLEÇÕES PRINCIPAIS ====================
    
    // CLIENTES - Usuário só acessa seus próprios clientes
    match /clientes/{clienteId} {
      allow read: if request.auth != null && 
          (request.auth.uid == resource.data.user_id || isAdmin());
      allow create: if request.auth != null && 
          request.resource.data.user_id == request.auth.uid;
      allow update: if request.auth != null && 
          isOwnerOrAdmin('user_id');
      allow delete: if request.auth != null && 
          isOwnerOrAdmin('user_id');
    }
    
    // VEÍCULOS - Acesso via cliente
    match /veiculos/{veiculoId} {
      allow read: if request.auth != null && 
          get(/databases/$(database)/documents/clientes/$(resource.data.cliente_id)).data.user_id == request.auth.uid;
      allow create: if request.auth != null && 
          get(/databases/$(database)/documents/clientes/$(request.resource.data.cliente_id)).data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null && 
          get(/databases/$(database)/documents/clientes/$(resource.data.cliente_id)).data.user_id == request.auth.uid;
    }
    
    // LAVAGENS - Acesso via cliente
    match /lavagens/{lavagemId} {
      allow read: if request.auth != null && 
          (get(/databases/$(database)/documents/clientes/$(resource.data.cliente_id)).data.user_id == request.auth.uid || isAdmin());
      allow create: if request.auth != null && 
          get(/databases/$(database)/documents/clientes/$(request.resource.data.cliente_id)).data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null && 
          get(/databases/$(database)/documents/clientes/$(resource.data.cliente_id)).data.user_id == request.auth.uid;
    }
    
    // PRODUTOS - Apenas admin pode gerenciar
    match /produtos/{produtoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }
    
    // MOVIMENTAÇÕES - Apenas admin pode gerenciar
    match /movimentacoes/{movimentacaoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }
    
    // ==================== COLEÇÕES GLOBAIS ====================
    
    // TIPOS DE LAVAGEM - Leitura pública, escrita apenas admin
    match /tipos_lavagem/{tipoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }
    
    // USUÁRIOS - Cada usuário gerencia apenas seu próprio perfil
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && 
          request.auth.uid == userId && 
          // Não permite alteração do role sem ser admin
          (request.resource.data.role == resource.data.role || isAdmin());
      //delete não permitido para usuários comuns
      allow delete: if request.auth != null && isAdmin();
    }
  }
}