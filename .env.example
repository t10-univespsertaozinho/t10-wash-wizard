# Wash Wizard - Environment Configuration
# Copy this file to .env and fill in your values

# Database Type: 'localstorage' or 'firebase'
VITE_DB_TYPE=localstorage

# Security - HMAC signing secret (change for production)
VITE_STORAGE_SECRET=your_secure_secret_key_min_32_chars

# Firebase Configuration (get these from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Application Settings
VITE_APP_NAME=Wash Wizard
VITE_APP_VERSION=1.0.0
