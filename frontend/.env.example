# URL da API Backend
# Em desenvolvimento com proxy Vite, pode ser omitido ou definido como /api
# Em produção (ex: Vercel), aponte para a URL do seu backend ou mantenha /api se no mesmo domínio
VITE_API_URL=/api

# Ambiente (development, production)
# NODE_ENV=development

# Configurações do Supabase (para migração futura e deploy)
# VITE_SUPABASE_URL=https://sua-instancia.supabase.co
# VITE_SUPABASE_ANON_KEY=sua-anon-key
